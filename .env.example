# Copy this file to .env and fill in your own values. Never commit .env to GitHub.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model name. Check AI Studio for the current free "flash" model if this one stops working.
GEMINI_MODEL=gemini-3.5-flash-lite

# Windows only: full path to tesseract.exe if it is not on your PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# SQLite file by default. For MySQL use: mysql+pymysql://user:password@localhost:3306/invoices
DATABASE_URL=sqlite:///./invoices.db
